" let g:test#strategy = 'vimterminal'
" let g:test#vim#term_position = 'belowright 20'

function! CloseTestBuffer()
  let test_buf = bufnr('term://*rspec*')
  if test_buf != -1
    let test_win = bufwinid(test_buf)
    if test_win != -1
      call win_gotoid(test_win)
      close!
    endif
    execute 'bdelete! ' . test_buf
  endif
endfunction

